---
import type { PageMetadata } from '../data/portfolio';
import { siteConfig } from '../data/portfolio';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

interface Props {
  metadata: PageMetadata;
}

const { metadata } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={metadata.description} />
    <meta name="viewport" content="width=device-width" />
    {metadata.canonicalUrl && <link rel="canonical" href={metadata.canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description} />
    {
      metadata.canonicalUrl && (
        <meta property="og:url" content={metadata.canonicalUrl} />
      )
    }
    {
      metadata.socialImageUrl && (
        <meta property="og:image" content={metadata.socialImageUrl} />
      )
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} />
    {
      metadata.socialImageUrl && (
        <meta name="twitter:image" content={metadata.socialImageUrl} />
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{metadata.title}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">
        <p>{siteConfig.ownerName} · {siteConfig.footerText}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-footer {
    font-size: 0.85rem;
  }

  .site-footer {
    padding-block: 2rem;
    border-top: 1px solid #bbb;
  }

  .site-footer p {
    margin-bottom: 0;
  }
</style>
