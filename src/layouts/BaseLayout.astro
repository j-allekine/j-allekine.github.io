---
import type { PageMetadata } from '../data/portfolio';
import { siteConfig } from '../data/portfolio';
import '../styles/global.css';

interface Props {
  metadata: PageMetadata;
}

const { metadata } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={metadata.description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{metadata.title}</title>
  </head>
  <body id="top">
    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="site-identity" href="/">{siteConfig.ownerName}</a>
        <span class="provisional">{siteConfig.footerText}</span>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">
        <p>{siteConfig.ownerName} · {siteConfig.footerText}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid #111;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.5rem;
    gap: 2rem;
  }

  .site-identity {
    font-weight: 700;
    text-decoration: none;
  }

  .site-header span,
  .site-footer {
    font-size: 0.85rem;
  }

  .site-footer {
    padding-block: 2rem;
    border-top: 1px solid #bbb;
  }

  .site-footer p {
    margin-bottom: 0;
  }
</style>
