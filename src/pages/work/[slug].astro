---
import type { GetStaticPaths } from 'astro';
import CaseStudyDetails from '../../components/CaseStudyDetails.astro';
import CaseStudyOverview from '../../components/CaseStudyOverview.astro';
import ProjectNavigation from '../../components/ProjectNavigation.astro';
import { projects, type Project } from '../../data/portfolio';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (() =>
  projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      previousProject: projects[index - 1],
      nextProject: projects[index + 1],
    },
  }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
  previousProject?: Project;
  nextProject?: Project;
}

const { project, previousProject, nextProject } = Astro.props;
---

<BaseLayout metadata={project.metadata}>
  <div class="case-study shell">
    <a class="back-link" href="/#featured-work">← Back to work</a>
    <CaseStudyOverview project={project} />
    <CaseStudyDetails project={project} />
    <ProjectNavigation
      previousProject={previousProject}
      nextProject={nextProject}
    />
  </div>
</BaseLayout>

<style>
  .case-study {
    padding-top: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .back-link {
    display: inline-block;
    font-weight: 700;
  }
</style>
