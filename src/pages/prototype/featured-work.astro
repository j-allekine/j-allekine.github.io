---
// PROTOTYPE — THROWAWAY.
// Three Featured Work treatments, switchable via ?variant=, on /prototype/featured-work.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectVisual from "../../components/work/ProjectVisual.astro";
import PrototypeSwitcher from "../../components/shared/PrototypeSwitcher.astro";
import { projects } from "../../data/projects";
import "@phosphor-icons/web/regular/style.css";

const variants = [
  { key: "A", name: "Editorial cards" },
  { key: "B", name: "Evidence stage" },
  { key: "C", name: "Project index" },
  { key: "D", name: "Production type scale" },
];
const current = "A";
---

<BaseLayout
  title="Prototype: Featured Work"
  description="Throwaway prototype comparing Featured Work layouts and deck behavior."
>
  <main class="prototype-page">
    <p class="prototype-notice">Throwaway prototype · temporary mockups · use the bottom bar to compare</p>

    <section class="work-section variant-a" data-variant="A" aria-labelledby="variant-a-title">
      <header class="section-heading">
        <div>
          <p>Featured projects</p>
          <h1 id="variant-a-title">Selected work.</h1>
        </div>
        <a href="/work">See all work <span aria-hidden="true">→</span></a>
      </header>

      <div class="peek-deck" data-deck data-prototype-keyboard-scope tabindex="0" aria-label="Featured projects. Use Left and Right Arrow keys to select a project.">
        {projects.map((project, index) => (
          <article class="project-card" data-card data-index={index} aria-label={`${index + 1} of ${projects.length}: ${project.title}`}>
            <ProjectVisual type={project.visual} />
            <div class="card-copy">
              <p class="card-number">0{index + 1}</p>
              <h2>{project.title}</h2>
              <p>{project.description}</p>
              <ul aria-label="Project tags">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
      <div class="position-dots" aria-hidden="true">{projects.map((_project, index) => <span data-dot={index}></span>)}</div>
      <p class="selection-state" data-status role="status" aria-live="polite"></p>
    </section>

    <section class="work-section variant-b" data-variant="B" aria-labelledby="variant-b-title" hidden>
      <header class="section-heading section-heading--stacked">
        <p>Featured projects</p>
        <h1 id="variant-b-title">Selected work.</h1>
        <p class="section-intro">Three practical systems built around real operational problems.</p>
      </header>

      <div class="stage-layout" data-deck>
        <div class="project-rail" aria-label="Choose a featured project">
          {projects.map((project, index) => (
            <button type="button" data-selector={index}>
              <span>0{index + 1}</span>
              {project.title}
            </button>
          ))}
        </div>
        <div class="stage" data-prototype-keyboard-scope tabindex="0" aria-label="Selected featured project. Use Left and Right Arrow keys to change projects.">
          {projects.map((project, index) => (
            <article class="stage-project" data-card data-index={index}>
              <ProjectVisual type={project.visual} />
              <div class="stage-copy">
                <p class="stage-kicker">{project.tags.join(" · ")}</p>
                <h2>{project.title}</h2>
                <p>{project.description}</p>
              </div>
            </article>
          ))}
        </div>
        <p class="selection-state" data-status role="status" aria-live="polite"></p>
      </div>
      <a class="all-work-block" href="/work">Explore all work <span aria-hidden="true">↗</span></a>
    </section>

    <section class="work-section variant-c" data-variant="C" aria-labelledby="variant-c-title" hidden>
      <header class="section-heading">
        <div>
          <p>Featured projects</p>
          <h1 id="variant-c-title">Selected work.</h1>
        </div>
        <a href="/work">See all work <span aria-hidden="true">→</span></a>
      </header>

      <div class="project-index" data-deck>
        {projects.map((project, index) => (
          <article class="index-row" data-card data-index={index}>
            <button type="button" data-selector={index} aria-expanded={index === 0 ? "true" : "false"}>
              <span class="index-number">0{index + 1}</span>
              <span class="index-title">{project.title}</span>
              <span class="index-tags">{project.tags.slice(0, 2).join(" / ")}</span>
              <span aria-hidden="true">+</span>
            </button>
            <div class="index-detail">
              <ProjectVisual type={project.visual} />
              <p>{project.description}</p>
            </div>
          </article>
        ))}
        <p class="selection-state" data-status role="status" aria-live="polite"></p>
      </div>
    </section>

    <section class="work-section variant-d" data-variant="D" aria-labelledby="variant-d-title" hidden>
      <header class="section-heading">
        <div>
          <p>Featured projects</p>
          <h1 id="variant-d-title">Selected work.</h1>
        </div>
        <a href="/work">See all work <span aria-hidden="true">→</span></a>
      </header>

      <div class="peek-deck" data-deck data-prototype-keyboard-scope tabindex="0" aria-label="Featured projects. Use Left and Right Arrow keys to select a project.">
        {projects.map((project, index) => (
          <article class:list={["project-card", { "is-active": index === 0, "is-next": index === 1 }]} data-card data-index={index} aria-label={`${index + 1} of ${projects.length}: ${project.title}`}>
            <ProjectVisual type={project.visual} />
            <div class="card-copy">
              <p class="card-number">0{index + 1}</p>
              <h2>{project.title}</h2>
              <p>{project.description}</p>
              <ul aria-label="Project tags">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
            </div>
          </article>
        ))}
        <button class="deck-chevron deck-chevron--previous" type="button" data-move="-1" aria-label="Previous project"><i class="ph ph-caret-left" aria-hidden="true"></i></button>
        <button class="deck-chevron deck-chevron--next" type="button" data-move="1" aria-label="Next project"><i class="ph ph-caret-right" aria-hidden="true"></i></button>
      </div>
      <div class="position-dots" aria-hidden="true">{projects.map((_project, index) => <span data-dot={index}></span>)}</div>
      <p class="selection-state" data-status role="status" aria-live="polite"></p>
    </section>
  </main>

  <PrototypeSwitcher variants={variants} current={current} />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>("[data-deck]").forEach((deck) => {
    const cards = [...deck.querySelectorAll<HTMLElement>("[data-card]")];
    const scope = deck.querySelector<HTMLElement>("[data-prototype-keyboard-scope]") ?? deck;
    const status = deck.querySelector<HTMLElement>("[data-status]") ?? deck.parentElement?.querySelector<HTMLElement>("[data-status]");
    let active = 0;

    const title = (card: HTMLElement) => card.querySelector("h2, .index-title")?.textContent?.trim() ?? "Project";
    const render = (announce = false) => {
      cards.forEach((card, index) => {
        const offset = (index - active + cards.length) % cards.length;
        card.classList.toggle("is-active", index === active);
        card.classList.toggle("is-next", offset === 1);
        card.classList.toggle("is-prev", offset === cards.length - 1);
        card.setAttribute("aria-current", String(index === active));
      });
      deck.querySelectorAll<HTMLElement>("[data-selector]").forEach((selector) => {
        const selected = Number(selector.dataset.selector) === active;
        selector.classList.toggle("is-active", selected);
        selector.setAttribute("aria-expanded", String(selected));
      });
      const dots = deck.parentElement?.querySelectorAll<HTMLElement>("[data-dot]") ?? [];
      dots.forEach((dot) => dot.classList.toggle("is-active", Number(dot.dataset.dot) === active));
      if (status) status.textContent = announce ? `${active + 1} of ${cards.length}: ${title(cards[active])}` : "";
    };
    const select = (index: number) => {
      active = (index + cards.length) % cards.length;
      render(true);
    };

    deck.querySelectorAll<HTMLElement>("[data-selector]").forEach((selector) => {
      selector.addEventListener("click", () => select(Number(selector.dataset.selector)));
    });
    deck.querySelectorAll<HTMLElement>("[data-move]").forEach((control) => {
      control.addEventListener("click", () => select(active + Number(control.dataset.move)));
    });
    cards.forEach((card, index) => {
      card.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest("[data-selector]")) return;
        if (index !== active) select(index);
      });
    });
    scope.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault();
      select(active + (event.key === "ArrowRight" ? 1 : -1));
    });
    render();
  });
</script>

<style>
  .prototype-page {
    overflow-x: clip;
    min-height: 100vh;
    padding: clamp(28px, 5vw, 72px) clamp(16px, 4vw, 56px) 120px;
    background:
      radial-gradient(circle at 80% 10%, rgb(111 78 55 / 13%), transparent 30rem),
      #0b0b0c;
  }

  .prototype-notice,
  .section-heading p,
  .card-number,
  .stage-kicker {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .prototype-notice {
    max-width: 1120px;
    margin: 0 auto 48px;
    color: #88888f;
  }

  .work-section {
    width: min(100%, 1120px);
    margin-inline: auto;
  }

  .variant-a {
    width: min(100%, 1024px);
  }

  .variant-d {
    width: min(100%, 1024px);
  }

  .work-section[hidden] {
    display: none;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }

  .section-heading p {
    margin: 0 0 8px;
    color: #a9a9af;
  }

  .section-heading h1 {
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 0.92;
    letter-spacing: -0.065em;
  }

  .variant-a .section-heading h1 {
    font-size: clamp(2.25rem, 5vw, 4.25rem);
  }

  .variant-d .section-heading h1 {
    font-size: var(--section-size);
    font-weight: 600;
    line-height: 1.03;
    letter-spacing: -0.043em;
  }

  .variant-d .section-heading p {
    margin-bottom: 10px;
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.13em;
  }

  .variant-d .section-heading a {
    font-size: 0.72rem;
  }

  .section-heading a,
  .all-work-block {
    color: #f0eee9;
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .peek-deck {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    outline: none;
  }

  .peek-deck:focus-visible,
  .stage:focus-visible {
    outline: 2px solid #e8cfae;
    outline-offset: 6px;
  }

  .project-card {
    overflow: hidden;
    border: 1px solid #29292d;
    border-radius: 5px;
    color: #171719;
    background: #e7e4dc;
  }

  .project-card :global(.work-visual),
  .stage-project :global(.work-visual),
  .index-detail :global(.work-visual) {
    min-height: 220px;
    border-bottom: 1px solid #c4c0b7;
    background: #d7d3ca;
  }

  .variant-a .project-card :global(.work-visual) {
    min-height: 170px;
  }

  .variant-d .project-card :global(.work-visual) {
    min-height: 170px;
  }

  .card-copy {
    padding: 18px;
  }

  .card-number {
    color: #6e6b65;
  }

  .card-copy h2,
  .stage-copy h2 {
    margin: 16px 0 10px;
    font-size: 1.25rem;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .card-copy > p:not(.card-number),
  .stage-copy > p:last-child {
    color: #55524d;
    font-size: 0.87rem;
    line-height: 1.55;
  }

  .variant-a .card-copy > p:not(.card-number) {
    display: -webkit-box;
    overflow: hidden;
    min-height: calc(1.55em * 3);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .variant-d .card-copy h2 {
    font-size: var(--card-title-size);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.028em;
  }

  .variant-d .card-copy > p:not(.card-number) {
    display: -webkit-box;
    overflow: hidden;
    min-height: calc(1.58em * 3);
    color: #55524d;
    font-size: 0.8125rem;
    line-height: 1.58;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .variant-d .card-copy li {
    font-size: 0.46875rem;
    font-weight: 500;
    letter-spacing: 0.035em;
  }

  .variant-d .peek-deck {
    position: relative;
    display: grid;
    overflow: visible;
    height: auto;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    padding-inline: 28px;
  }

  .variant-d .project-card {
    position: static;
    display: none;
    width: auto;
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  .variant-d .project-card.is-active,
  .variant-d .project-card.is-next {
    display: block;
  }

  .variant-d .deck-chevron {
    position: absolute;
    z-index: 4;
    top: 50%;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 0;
    border-radius: 50%;
    color: #f0eee9;
    background: transparent;
    font-size: 0.9375rem;
    cursor: pointer;
    opacity: 0.62;
    transition:
      color 160ms ease,
      opacity 160ms ease;
    transform: translateY(-50%);
  }

  .variant-d .deck-chevron i {
    position: relative;
    z-index: 1;
    transition: transform 160ms ease;
  }

  .variant-d .deck-chevron i::before {
    color: inherit;
  }

  .variant-d .peek-deck:hover .deck-chevron,
  .variant-d .peek-deck:focus-within .deck-chevron,
  .variant-d .deck-chevron:hover {
    opacity: 1;
    color: #ffffff;
  }

  .variant-d .deck-chevron--previous:hover i {
    transform: translateX(-2px);
  }

  .variant-d .deck-chevron--next:hover i {
    transform: translateX(2px);
  }

  .variant-d .deck-chevron:active i {
    transform: scale(0.86);
  }

  .variant-d .deck-chevron:focus-visible {
    outline: 2px solid #111113;
    outline-offset: 2px;
  }

  .variant-d .deck-chevron--previous {
    left: 6px;
  }

  .variant-d .deck-chevron--next {
    right: 6px;
  }

  @media (hover: none), (pointer: coarse) {
    .variant-d .deck-chevron {
      opacity: 1;
    }
  }

  @media (min-width: 1280px) {
    .variant-d .peek-deck {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding-inline: 0;
    }

    .variant-d .project-card {
      display: block;
    }

    .variant-d .deck-chevron {
      display: none;
    }
  }

  .card-copy ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .card-copy li {
    padding: 5px 8px;
    border: 1px solid #bbb6ad;
    border-radius: 99px;
    font-family: var(--mono);
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  .position-dots {
    display: none;
    justify-content: center;
    gap: 7px;
    margin-top: 20px;
  }

  .position-dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4a4a4f;
  }

  .position-dots span.is-active {
    background: #f0eee9;
  }

  .selection-state {
    min-height: 1em;
    margin: 12px 0 0;
    color: #85858c;
    font-family: var(--mono);
    font-size: 0.65rem;
    text-align: center;
  }

  .variant-d .selection-state {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .deck-chevron {
    display: none;
  }

  .section-heading--stacked {
    display: block;
    max-width: 700px;
  }

  .section-intro {
    max-width: 520px;
    margin-top: 20px !important;
    font-family: inherit !important;
    font-size: 1rem !important;
    line-height: 1.6;
    letter-spacing: 0 !important;
    text-transform: none !important;
  }

  .stage-layout {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    border-block: 1px solid #29292d;
  }

  .project-rail {
    border-right: 1px solid #29292d;
  }

  .project-rail button {
    display: grid;
    width: 100%;
    grid-template-columns: 32px 1fr;
    gap: 8px;
    padding: 22px 18px;
    border: 0;
    border-bottom: 1px solid #29292d;
    color: #aaaab0;
    background: transparent;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .project-rail button.is-active {
    color: #111113;
    background: #e8cfae;
  }

  .project-rail span {
    font-family: var(--mono);
    font-size: 0.64rem;
  }

  .stage {
    min-width: 0;
    outline: none;
  }

  .stage-project {
    display: none;
    grid-template-columns: 1.2fr 0.8fr;
    min-height: 430px;
  }

  .stage-project.is-active {
    display: grid;
  }

  .stage-project :global(.work-visual) {
    min-height: 100%;
    border: 0;
  }

  .stage-copy {
    align-self: end;
    padding: 32px;
    color: #171719;
    background: #e7e4dc;
  }

  .stage-kicker {
    color: #6e6b65 !important;
  }

  .all-work-block {
    display: flex;
    justify-content: space-between;
    padding: 18px 0;
    border-bottom: 1px solid #29292d;
  }

  .project-index {
    border-top: 1px solid #343438;
  }

  .index-row {
    border-bottom: 1px solid #343438;
  }

  .index-row > button {
    display: grid;
    width: 100%;
    grid-template-columns: 56px 1fr 180px 20px;
    align-items: center;
    gap: 16px;
    padding: 25px 4px;
    border: 0;
    color: #c8c8cd;
    background: transparent;
    text-align: left;
    cursor: pointer;
  }

  .index-row.is-active > button {
    color: #f4f1ea;
  }

  .index-number,
  .index-tags {
    color: #85858c;
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
  }

  .index-title {
    font-size: clamp(1.25rem, 3vw, 2.3rem);
    letter-spacing: -0.04em;
  }

  .index-detail {
    display: none;
    grid-template-columns: minmax(0, 1.25fr) minmax(240px, 0.75fr);
    gap: 28px;
    padding: 4px 4px 28px 76px;
  }

  .index-row.is-active .index-detail {
    display: grid;
  }

  .index-detail :global(.work-visual) {
    min-height: 300px;
    border: 0;
  }

  .index-detail p {
    align-self: end;
    color: #aaaab0;
    line-height: 1.6;
  }

  @media (max-width: 1279px) {
    .peek-deck {
      position: relative;
      display: block;
      height: 465px;
      overflow: hidden;
    }

    .project-card {
      position: absolute;
      top: 0;
      left: 50%;
      width: min(calc(100% - 96px), 320px);
      opacity: 0;
      pointer-events: none;
      transform: translateX(-50%) scale(0.9);
      transition: opacity 180ms ease;
    }

    .project-card.is-active,
    .project-card.is-prev,
    .project-card.is-next {
      opacity: 1;
      pointer-events: auto;
    }

    .project-card.is-active {
      z-index: 2;
      transform: translateX(-50%);
    }

    .project-card.is-prev {
      left: 0;
      transform: translateX(calc(-100% + 28px)) rotate(-1deg);
    }

    .project-card.is-next {
      left: 100%;
      transform: translateX(-28px) rotate(1deg);
    }

    .position-dots {
      display: flex;
    }
  }

  @media (max-width: 760px) {
    .prototype-notice {
      margin-bottom: 34px;
    }

    .section-heading {
      align-items: start;
    }

    .section-heading > a {
      max-width: 90px;
      text-align: right;
    }

    .stage-layout {
      display: block;
    }

    .project-rail {
      display: flex;
      overflow-x: auto;
      border: 0;
    }

    .project-rail button {
      min-width: 210px;
      border-right: 1px solid #29292d;
    }

    .stage-project,
    .stage-project.is-active {
      grid-template-columns: 1fr;
    }

    .stage-project :global(.work-visual) {
      min-height: 300px;
    }

    .variant-d .peek-deck {
      display: block;
      padding-inline: 26px;
    }

    .variant-d .project-card.is-next {
      display: none;
    }

    .variant-d .deck-chevron {
      width: 44px;
      height: 44px;
    }

    .variant-d .deck-chevron--previous {
      left: 6px;
    }

    .variant-d .deck-chevron--next {
      right: 6px;
    }

    .index-row > button {
      grid-template-columns: 38px 1fr 20px;
    }

    .index-tags {
      display: none;
    }

    .index-detail {
      grid-template-columns: 1fr;
      padding-left: 42px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }
  }
</style>
