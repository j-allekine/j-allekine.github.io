---
// PROTOTYPE — THROWAWAY.
// Three full Hero compositions, switchable via ?variant=, on /prototype/hero-composition.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/shared/Button.astro";
import PrototypeSwitcher from "../../components/shared/PrototypeSwitcher.astro";

const variants = [
  { key: "A", name: "Reserved portrait" },
  { key: "B", name: "Image-led split" },
  { key: "C", name: "Bryl-inspired hybrid" },
];
---

<BaseLayout
  title="Prototype: Desktop Hero Composition"
  description="Throwaway prototype comparing portrait and text balance in the homepage Hero."
>
  <main class="composition-page" id="top">
    <p class="prototype-banner">
      Throwaway prototype · desktop target starts at 1280px
    </p>

    <section class="hero hero--reserved" data-variant="A" aria-labelledby="reserved-title">
      <div class="portrait portrait--reserved" aria-hidden="true">
        <span>Portrait placeholder</span>
      </div>
      <div class="copy">
        <h1 id="reserved-title">Jihm Allekine<br />Almedilla</h1>
        <p class="statement">I am an automation specialist.</p>
        <p>
          I build spreadsheet systems, workflow automations, data tools, and practical software that turn manual
          processes into clearer, more reliable operations. I enjoy mapping workflows, understanding the details,
          and building useful tools that people can rely on.
        </p>
        <p class="faith">
          My Christian faith shapes how I approach my work. I see building as an act of stewardship: serving people
          well, pursuing excellence, and creating work that honors God.
        </p>
        <div class="actions">
          <Button href="#selected-work">View selected work <span aria-hidden="true">↓</span></Button>
          <Button href="/contact" variant="ghost">Contact me <span aria-hidden="true">↗</span></Button>
        </div>
      </div>
      <p class="variant-note">
        A · fluid reserved portrait · <output data-reserved-state aria-live="polite"></output>
      </p>
    </section>

    <section class="hero hero--image-led" data-variant="B" aria-labelledby="image-led-title" hidden>
      <div class="portrait portrait--image-led" aria-hidden="true">
        <span>Portrait placeholder</span>
      </div>
      <div class="copy">
        <p class="identity-kicker">Operational problem-solver</p>
        <h1 id="image-led-title">Jihm Allekine<br />Almedilla</h1>
        <p class="statement">I am an automation specialist.</p>
        <p>
          I build spreadsheet systems, workflow automations, data tools, and practical software that turn manual
          processes into clearer, more reliable operations.
        </p>
        <p class="faith">
          My Christian faith shapes how I approach my work. I see building as an act of stewardship: serving people
          well, pursuing excellence, and creating work that honors God.
        </p>
        <div class="actions">
          <Button href="#selected-work">View selected work <span aria-hidden="true">↓</span></Button>
          <Button href="/contact" variant="ghost">Contact me <span aria-hidden="true">↗</span></Button>
        </div>
      </div>
      <p class="variant-note">B · larger 400px portrait + tighter copy</p>
    </section>

    <section class="hero hero--compact" data-variant="C" aria-labelledby="compact-title" hidden>
      <div class="portrait portrait--compact" aria-hidden="true">
        <span>Portrait placeholder</span>
      </div>
      <div class="copy">
        <h1 id="compact-title">Jihm Allekine<br />Almedilla</h1>
        <p class="statement">I am an automation specialist.</p>
        <p>
          I build spreadsheet systems, workflow automations, data tools, and practical software that turn manual
          processes into clearer, more reliable operations.
        </p>
        <p class="faith">
          My Christian faith shapes how I approach my work. I see building as stewardship: serving people well,
          pursuing excellence, and creating work that honors God.
        </p>
        <div class="compact-actions">
          <a class="compact-button compact-button--primary" href="#selected-work">View selected work <span aria-hidden="true">↓</span></a>
          <a class="compact-button compact-button--secondary" href="/contact">Contact me <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <p class="variant-note">C · Bryl-inspired compact shell + restrained buttons</p>
    </section>

    <section id="selected-work" class="work-target" aria-label="Selected Work destination">
      Featured Work begins here
    </section>
  </main>

  <PrototypeSwitcher variants={variants} current="A" />
</BaseLayout>

<script>
  const reservedState = document.querySelector<HTMLOutputElement>("[data-reserved-state]");

  const updateReservedState = () => {
    const hero = document.querySelector<HTMLElement>(".hero--reserved");
    const heading = hero?.querySelector<HTMLElement>("h1");
    const portrait = hero?.querySelector<HTMLElement>(".portrait");
    if (!reservedState || !heading || !portrait) return;

    const headingSize = Math.round(Number.parseFloat(getComputedStyle(heading).fontSize));
    const portraitWidth = Math.round(portrait.getBoundingClientRect().width);
    const mode = window.innerWidth >= 1280 ? "desktop portrait-right" : "portrait-first";
    reservedState.textContent = `${window.innerWidth}px viewport · ${headingSize}px name · ${portraitWidth}px portrait · ${mode}`;
  };

  window.addEventListener("resize", updateReservedState);
  updateReservedState();
</script>

<style>
  .composition-page {
    min-height: 100vh;
  }

  .prototype-banner {
    width: min(calc(100% - 32px), 1100px);
    margin: 0 auto;
    padding-top: 24px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.67rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero {
    position: relative;
    width: min(calc(100% - 32px), 1100px);
    margin-inline: auto;
    padding-block: 28px 72px;
  }

  .hero[hidden] {
    display: none;
  }

  .portrait {
    display: grid;
    width: min(100%, clamp(288px, 45vw, 300px));
    aspect-ratio: 4 / 5;
    margin: 0 auto 32px;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    color: var(--subtle);
    background:
      linear-gradient(135deg, transparent 49.8%, var(--line) 50%, transparent 50.2%),
      linear-gradient(45deg, transparent 49.8%, var(--line) 50%, transparent 50.2%),
      radial-gradient(circle at 50% 30%, rgba(255, 255, 255, 0.06), transparent 42%),
      var(--surface);
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .copy {
    min-width: 0;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.7rem, calc(2rem + 3vw), 3.75rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.06em;
    text-transform: uppercase;
  }

  .statement {
    margin: 24px 0 0;
    font-size: clamp(1.15rem, 4.8vw, 1.45rem);
    font-weight: 600;
    line-height: 1.3;
  }

  .copy > p:not(.statement, .faith, .identity-kicker) {
    margin: 20px 0 0;
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .faith {
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .identity-kicker {
    margin: 0 0 12px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .actions {
    display: grid;
    gap: 10px;
    margin-top: 28px;
  }

  .actions :global(.button) {
    width: 100%;
  }

  .compact-actions {
    display: grid;
    gap: 8px;
    margin-top: 26px;
  }

  .compact-button {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding-inline: 14px;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    transition: border-color var(--ease), background-color var(--ease), color var(--ease);
  }

  .compact-button--primary {
    border-color: #d4d4d8;
    color: #09090b;
    background: #d4d4d8;
  }

  .compact-button--secondary {
    color: #d4d4d8;
    background: rgba(255, 255, 255, 0.025);
  }

  .compact-button:hover {
    border-color: #fff;
  }

  .compact-button--primary:hover {
    background: #f4f4f5;
  }

  .variant-note {
    margin: 36px 0 0;
    color: var(--subtle);
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .work-target {
    display: grid;
    min-height: 40vh;
    place-items: center;
    border-top: 1px solid var(--line);
    color: var(--muted);
    background: var(--surface);
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  @media (min-width: 480px) {
    .actions {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
    }

    .actions :global(.button) {
      width: auto;
    }

    .compact-actions {
      display: flex;
      flex-wrap: wrap;
    }
  }

  @media (min-width: 1280px) {
    .hero {
      min-height: 700px;
      align-content: center;
      padding-block: 72px 96px;
    }

    .portrait {
      width: 100%;
      margin: 0;
    }

    .hero--reserved {
      --reserved-portrait: clamp(300px, calc(12.5vw + 140px), 320px);
      display: grid;
      grid-template:
        "copy portrait" auto
        "note note" auto /
        minmax(0, 560px) var(--reserved-portrait);
      gap: 32px 64px;
      justify-content: center;
    }

    .hero--reserved .copy {
      grid-area: copy;
      align-self: center;
    }

    .hero--reserved .portrait {
      grid-area: portrait;
      align-self: center;
    }

    .hero--reserved h1 {
      font-size: clamp(3.75rem, calc(5vw - 4px), 4.25rem);
    }

    .hero--image-led {
      display: grid;
      grid-template:
        "copy portrait" auto
        "note note" auto /
        minmax(0, 1fr) 400px;
      gap: 32px 72px;
      align-items: center;
    }

    .hero--image-led .copy {
      grid-area: copy;
      max-width: 500px;
    }

    .hero--image-led .portrait {
      grid-area: portrait;
    }

    .hero--image-led h1 {
      font-size: 3.65rem;
    }

    .hero--compact {
      display: grid;
      width: min(calc(100% - 32px), 760px);
      min-height: 620px;
      grid-template:
        "portrait copy" auto
        "note note" auto /
        288px minmax(0, 1fr);
      gap: 32px 40px;
      align-items: start;
    }

    .hero--compact .portrait {
      grid-area: portrait;
      aspect-ratio: 0.96;
    }

    .hero--compact .copy {
      grid-area: copy;
    }

    .hero--compact h1 {
      font-size: 2.6rem;
      line-height: 1;
      letter-spacing: -0.045em;
    }

    .hero--compact .statement {
      margin-top: 20px;
      font-size: 1.1rem;
    }

    .hero--compact .copy > p:not(.statement, .faith) {
      font-size: 0.94rem;
    }

    .variant-note {
      grid-area: note;
      margin-top: 0;
    }
  }
</style>
