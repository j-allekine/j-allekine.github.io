---
import type { Project } from '../data/portfolio';
import CaseStudySection from './CaseStudySection.astro';
import ProjectFigure from './ProjectFigure.astro';

interface Props {
  project: Project;
  guiding: boolean;
}

const { project, guiding } = Astro.props;
---

<CaseStudySection
  id="gallery"
  eyebrow="06 · Artifacts"
  heading="Project Gallery"
  guidingNote={guiding
    ? 'Guiding media · Replace only with artifacts that help explain a decision, workflow, or outcome.'
    : undefined}
>
  <div class="gallery-grid">
    {
      project.gallery.map((media) => (
        <ProjectFigure media={media} />
      ))
    }
  </div>
</CaseStudySection>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4rem) 2rem;
  }

  .gallery-grid :global(.project-figure--featured) {
    grid-column: 1 / -1;
  }

  @media (max-width: 40rem) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .gallery-grid :global(.project-figure--featured) {
      grid-column: auto;
    }
  }
</style>
