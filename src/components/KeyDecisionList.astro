---
import type { Project } from '../data/portfolio';
import CaseStudySection from './CaseStudySection.astro';

interface Props {
  project: Project;
  guiding: boolean;
}

const { project, guiding } = Astro.props;
---

<CaseStudySection
  id="decisions"
  eyebrow="05 · Judgment"
  heading="Key Decisions"
  guidingNote={guiding
    ? 'Guiding content · Replace with two or three decisions that materially shaped the work.'
    : undefined}
>
  <div class="decision-list">
    {
      project.keyDecisions.map((item, index) => (
        <article class="decision">
          <p class="eyebrow">Decision {String(index + 1).padStart(2, '0')}</p>
          <dl>
            <div>
              <dt>Decision</dt>
              <dd>{item.decision}</dd>
            </div>
            <div>
              <dt>Reasoning</dt>
              <dd>{item.reasoning}</dd>
            </div>
            <div>
              <dt>Trade-off</dt>
              <dd>{item.tradeoff}</dd>
            </div>
          </dl>
        </article>
      ))
    }
  </div>
</CaseStudySection>

<style>
  .decision-list {
    border-top: 1px solid #111;
  }

  .decision {
    display: grid;
    grid-template-columns: minmax(9rem, 3fr) 9fr;
    gap: 2rem;
    padding-block: 2rem;
    border-bottom: 1px solid #111;
  }

  .decision dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin-bottom: 0;
  }

  .decision dd {
    margin-left: 0;
  }

  @media (max-width: 48rem) {
    .decision,
    .decision dl {
      grid-template-columns: 1fr;
    }

    .decision {
      gap: 0.75rem;
    }
  }
</style>
