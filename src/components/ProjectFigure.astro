---
import type { ProjectMedia } from '../data/portfolio';

interface Props {
  media: ProjectMedia;
  loading?: 'eager' | 'lazy';
}

const { media, loading = 'lazy' } = Astro.props;
---

<figure
  class:list={[
    'project-figure',
    { 'project-figure--featured': media.featured },
  ]}
>
  <div class="project-figure__frame">
    <img
      src={media.src}
      alt={media.alt}
      width={media.width}
      height={media.height}
      loading={loading}
      decoding="async"
    />
  </div>
  <figcaption>{media.caption}</figcaption>
</figure>

<style>
  .project-figure {
    margin: 0;
  }

  .project-figure__frame {
    overflow: hidden;
    border: 1px solid #111;
    background: #f4f4f1;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  figcaption {
    max-width: 68ch;
    margin-top: 0.75rem;
    color: #454545;
    font-size: 0.9rem;
    line-height: 1.45;
  }
</style>
