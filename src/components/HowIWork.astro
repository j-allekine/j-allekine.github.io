---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import type { HowIWorkStage } from '../data/portfolio';

interface Props {
  stages: readonly HowIWorkStage[];
  eyebrow?: string;
  heading?: string;
}

const {
  stages,
  eyebrow = 'Working approach',
  heading = 'How I work',
} = Astro.props;
---

<section class="how-i-work shell" aria-labelledby="how-i-work-heading">
  <header class="how-i-work__header">
    <p class="how-i-work__eyebrow">{eyebrow}</p>
    <h2 id="how-i-work-heading">{heading}</h2>
  </header>

  <ol class="how-i-work__rail">
    {
      stages.map((stage) => (
        <li class="how-i-work__stage">
          <p class="how-i-work__number">{stage.number}</p>
          <h3>{stage.title}</h3>
          <p class="how-i-work__description">{stage.description}</p>
          <p class="how-i-work__principle">{stage.principle}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .how-i-work {
    padding-block: clamp(4rem, 8vw, 7rem);
    font-family: 'Geist Variable', Arial, Helvetica, sans-serif;
  }

  .how-i-work__header {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .how-i-work__eyebrow,
  .how-i-work__number,
  .how-i-work__principle {
    font-family: 'Geist Mono Variable', 'Courier New', monospace;
  }

  .how-i-work__eyebrow {
    grid-column: 1 / span 3;
    margin: 0;
    color: #555;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .how-i-work__header h2 {
    grid-column: 4 / -1;
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 550;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .how-i-work__rail {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid #111;
  }

  .how-i-work__stage {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 1rem;
    min-height: 24rem;
    padding: 1.25rem 1.25rem 1.5rem;
    border-right: 1px solid #bbb;
  }

  .how-i-work__stage:first-child {
    border-left: 1px solid #bbb;
  }

  .how-i-work__number {
    margin: 0;
    color: #555;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .how-i-work__stage h3 {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    font-weight: 550;
    line-height: 1.15;
  }

  .how-i-work__description {
    margin: 0;
    color: #222;
  }

  .how-i-work__principle {
    margin: 0;
    color: #555;
    font-size: 0.78rem;
    font-weight: 550;
    letter-spacing: 0.02em;
  }

  @media (max-width: 48rem) {
    .how-i-work__header {
      display: block;
      margin-bottom: 2.5rem;
    }

    .how-i-work__eyebrow {
      margin-bottom: 0.75rem;
    }

    .how-i-work__header h2 {
      font-size: clamp(2rem, 10vw, 2.75rem);
    }

    .how-i-work__rail {
      display: block;
      border-left: 1px solid #bbb;
    }

    .how-i-work__stage {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      column-gap: 1rem;
      min-height: 0;
      padding: 1.5rem 0 1.5rem 1.5rem;
      border-right: 0;
      border-bottom: 1px solid #bbb;
      border-left: 0;
    }

    .how-i-work__stage:first-child {
      border-left: 0;
    }

    .how-i-work__number {
      grid-row: 1 / span 3;
    }

    .how-i-work__principle {
      grid-column: 2;
    }
  }
</style>
