---
import type { Project } from '../data/portfolio';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const artifact = project.solution.primaryMedia;
---

<article class="card">
  <div class="card__topline">
    <span>Project {project.number}</span>
    <span>{project.category}</span>
  </div>

  <div class="card__artifact" data-card-artifact>
    {
      artifact ? (
        <img
          src={artifact.src}
          alt=""
          width={artifact.width}
          height={artifact.height}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span>Artifact pending owner input</span>
      )
    }
  </div>

  <p class="provisional">Provisional project record</p>
  <h3>{project.title}</h3>
  <p class="summary">{project.summary}</p>

  <dl>
    <div>
      <dt>Role</dt>
      <dd>{project.role}</dd>
    </div>
    <div>
      <dt>System type</dt>
      <dd>{project.industryOrSystemType}</dd>
    </div>
    <div>
      <dt>Year</dt>
      <dd>{project.year}</dd>
    </div>
    <div>
      <dt>Tools</dt>
      <dd class="metadata-value">{project.tools.join(', ')}</dd>
    </div>
  </dl>

  <a class="card__link" href={`/work/${project.slug}/`}>
    Open provisional case study: {project.title} <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid #111;
    transition:
      background-color var(--motion-duration) var(--motion-easing),
      border-color var(--motion-duration) var(--motion-easing);
  }

  .card:hover {
    border-color: #555;
    background: #fafafa;
  }

  .card__topline {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #bbb;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .card__artifact {
    display: grid;
    min-height: 8rem;
    margin-top: 1.5rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid #bbb;
    background: #f4f4f1;
    color: #555;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .card__artifact img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .provisional {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.85rem;
  }

  h3 {
    margin-block: 0 1rem;
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    line-height: 1.05;
  }

  .summary {
    max-width: 56ch;
    margin-bottom: 2rem;
    font-size: 1.1em;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 2rem;
    padding-block: 1.5rem;
    border-block: 1px solid #bbb;
  }

  dd {
    margin-left: 0;
  }

  .card__link {
    display: inline-block;
    margin-top: auto;
    padding-top: 1.5rem;
    font-weight: 700;
  }

  @media (max-width: 35rem) {
    dl {
      grid-template-columns: 1fr;
    }
  }
</style>
