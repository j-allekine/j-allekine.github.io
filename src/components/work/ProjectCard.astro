---
import type { Project } from "../../data/projects";
import ProjectVisual from "./ProjectVisual.astro";

interface Props {
  project: Project;
  index: number;
  total: number;
  showCaseStudyLink?: boolean;
}

const { project, index, total, showCaseStudyLink = true } = Astro.props;
---

<article
  class="work-card"
  role="group"
  aria-roledescription="slide"
  aria-label={`${index + 1} of ${total}: ${project.title}`}
  aria-posinset={index + 1}
  aria-setsize={total}
>
  <ProjectVisual type={project.visual} />
  <div class="work-body">
    <h3>{project.title}</h3>
    <p>{project.description}</p>

    <div class="work-type" aria-label="Project stack and industry">
      {project.tags.map((tag) => <span>{tag}</span>)}
    </div>

    {showCaseStudyLink && (
      <a class="work-link" href={project.href}>
        View case study <span class="arrow" aria-hidden="true">↗</span>
      </a>
    )}
  </div>
</article>
