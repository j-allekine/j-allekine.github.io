---
import type { Project } from "../../data/projects";
import ProjectVisual from "./ProjectVisual.astro";

interface Props {
  project: Project;
  index: number;
  total: number;
}

const { project, index, total } = Astro.props;
const { title, summary, tags, visual, destination } = project.data;
---

<article
  class="work-card"
  role="group"
  aria-roledescription="slide"
  aria-label={`${index + 1} of ${total}: ${title}`}
>
  <ProjectVisual type={visual.type} />
  <div class="work-body">
    <h3>{title}</h3>
    <p>{summary}</p>

    <div class="work-type" aria-label="Project stack and industry">
      {tags.map((tag) => <span>{tag}</span>)}
    </div>

    {destination && (
      <a class="work-link" href={destination}>
        View case study <span class="arrow" aria-hidden="true">↗</span>
      </a>
    )}
  </div>
</article>
