---
import ProjectCard from "./ProjectCard.astro";
import { getProjects } from "../../data/projects";

const projects = await getProjects();
---

<section class="section" id="work-page">
  <div class="content-shell">
    <div class="section-heading">
      <div>
        <p class="section-label">Featured systems</p>
        <h1>Selected work.</h1>
      </div>
    </div>

    <div class="work-grid work-grid--index">
      {projects.map((project, index) => <ProjectCard project={project} index={index} total={projects.length} />)}
    </div>
  </div>
</section>

<style>
  .work-grid--index {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 18px;
    height: auto;
    min-height: 0;
    overflow: visible;
    isolation: auto;
  }

  .work-grid--index :global(.work-card) {
    position: relative;
    grid-area: auto;
    display: flex;
    flex: 0 1 calc((100% - 36px) / 3);
    width: auto;
    height: auto;
    min-height: 100%;
    margin: 0;
    inset: auto;
    opacity: 1;
    pointer-events: auto;
    transform: none;
    justify-self: auto;
  }

  @media (max-width: 1040px) {
    .work-grid--index {
      display: flex;
    }

    .work-grid--index :global(.work-card) {
      flex-basis: calc((100% - 18px) / 2);
    }
  }

  @media (max-width: 720px) {
    .work-grid--index :global(.work-card) {
      flex-basis: 100%;
    }
  }
</style>
