---
import type { SiteConfig } from '../data/portfolio';

interface Props {
  ownerName: SiteConfig['ownerName'];
  footerText: SiteConfig['footerText'];
  location?: SiteConfig['location'];
}

const { ownerName, footerText, location } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div>
      <p>{ownerName} · {footerText}</p>
      {location && <p>{location}</p>}
    </div>
    <p>© {currentYear}</p>
    <a href="#top">Back to top ↑</a>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 2rem;
    border-top: 1px solid #bbb;
    font-size: 0.85rem;
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: start;
    gap: 1rem clamp(1.5rem, 4vw, 4rem);
  }

  .site-footer p {
    margin-bottom: 0;
  }

  .site-footer__inner div p + p {
    margin-top: 0.25rem;
  }

  @media (max-width: 40rem) {
    .site-footer__inner {
      grid-template-columns: 1fr auto;
    }

    .site-footer__inner div {
      grid-column: 1 / -1;
    }
  }
</style>
