---
import type { Project } from '../data/portfolio';
import CaseStudyResults from './CaseStudyResults.astro';
import CaseStudySection from './CaseStudySection.astro';
import KeyDecisionList from './KeyDecisionList.astro';
import ProjectFigure from './ProjectFigure.astro';
import ProjectGallery from './ProjectGallery.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const guiding = project.contentStatus === 'guiding';
---

<CaseStudySection
  id="problem"
  eyebrow="01 · Context"
  heading="Problem"
  guidingNote={guiding
    ? 'Guiding content · Replace with confirmed project details.'
    : undefined}
>
  <ul class="problem-list">
    <li>
      <strong>What was happening</strong>
      <span>{project.problem.whatWasHappening}</span>
    </li>
    <li>
      <strong>Who was affected</strong>
      <span>{project.problem.whoWasAffected}</span>
    </li>
    <li>
      <strong>Why it mattered</strong>
      <span>{project.problem.whyItMattered}</span>
    </li>
  </ul>
</CaseStudySection>

<CaseStudySection id="solution" eyebrow="02 · Workflow" heading="Solution">
  <div class="reading-column">
    <p>{project.solution.description}</p>
    <ol class="workflow">
      {project.solution.workflowSteps.map((step) => <li>{step}</li>)}
    </ol>
  </div>
  {
    project.solution.primaryMedia && (
      <div class="primary-media">
        <ProjectFigure media={project.solution.primaryMedia} loading="eager" />
      </div>
    )
  }
</CaseStudySection>

<CaseStudySection
  id="contribution"
  eyebrow="03 · Scope"
  heading="My Contribution"
  guidingNote={guiding
    ? 'Guiding content · Each final item must name J. Allekine’s work, not the project’s total output.'
    : undefined}
>
  <ul class="contribution-list">
    {project.contribution.map((item) => <li>{item}</li>)}
  </ul>
</CaseStudySection>

<CaseStudyResults project={project} guiding={guiding} />
<KeyDecisionList project={project} guiding={guiding} />
<ProjectGallery project={project} guiding={guiding} />

<style>
  .reading-column {
    max-width: 68ch;
  }

  .problem-list,
  .contribution-list,
  .workflow {
    margin-block: 0;
    padding: 0;
    list-style: none;
  }

  .problem-list li,
  .contribution-list li,
  .workflow li {
    display: grid;
    grid-template-columns: minmax(9rem, 3fr) 9fr;
    gap: 2rem;
    padding-block: 1.25rem;
    border-top: 1px solid #bbb;
  }

  .problem-list li:last-child,
  .contribution-list li:last-child,
  .workflow li:last-child {
    border-bottom: 1px solid #bbb;
  }

  .problem-list strong,
  .workflow li::before {
    font-family: "Courier New", Courier, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .workflow {
    margin-top: 2rem;
    counter-reset: workflow;
  }

  .workflow li {
    counter-increment: workflow;
  }

  .workflow li::before {
    content: "Step " counter(workflow, decimal-leading-zero);
    font-weight: 700;
  }

  .primary-media {
    margin-top: 1.5rem;
  }

  .contribution-list li {
    position: relative;
    grid-template-columns: 2rem minmax(0, 1fr);
  }

  .contribution-list li::before {
    content: "→";
    font-weight: 700;
  }

  @media (max-width: 48rem) {
    .problem-list li,
    .workflow li {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
