---
import type { Project } from '../data/portfolio';

interface Props {
  previousProject?: Project;
  nextProject?: Project;
}

const { previousProject, nextProject } = Astro.props;
---

<nav class="project-navigation" aria-label="Case study projects">
  {
    previousProject && (
      <a class="project-navigation__link" href={`/work/${previousProject.slug}/`}>
        <span class="eyebrow">← Previous project</span>
        <span>{previousProject.title}</span>
      </a>
    )
  }
  {
    nextProject && (
      <a
        class="project-navigation__link project-navigation__link--next"
        href={`/work/${nextProject.slug}/`}
      >
        <span class="eyebrow">Next project →</span>
        <span>{nextProject.title}</span>
      </a>
    )
  }
</nav>

<style>
  .project-navigation {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    padding-top: clamp(2rem, 5vw, 4rem);
    border-top: 1px solid #111;
  }

  .project-navigation__link {
    display: grid;
    gap: 0.5rem;
    max-width: 28rem;
    text-underline-offset: 0.25em;
  }

  .project-navigation__link--next {
    grid-column: 2;
    justify-self: end;
    text-align: right;
  }

  @media (max-width: 40rem) {
    .project-navigation {
      grid-template-columns: 1fr;
    }

    .project-navigation__link--next {
      grid-column: auto;
      justify-self: start;
      text-align: left;
    }
  }
</style>
