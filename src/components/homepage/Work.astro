---
import SectionHeader from "../shared/SectionHeader.astro";
import ProjectCard from "../work/ProjectCard.astro";
import { getFeaturedProjects } from "../../data/projects";

const projects = await getFeaturedProjects();
---

<section class="section" id="work">
  <div class="content-shell">
    <SectionHeader label="Featured projects" title="Selected work." href="/work" linkLabel="See all work" />

    <div
      class="work-carousel"
      data-work-carousel
      role="region"
      aria-roledescription="carousel"
      aria-label="Featured Work carousel"
      aria-describedby="work-deck-status"
    >
      <button class="work-carousel__control work-carousel__control--prev" type="button" aria-label="Show previous project" data-work-prev>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 6-6 6 6 6"></path></svg>
      </button>

      <div class="work-grid" data-work-track tabindex="0" role="group">
        {projects.map((project, index) => <ProjectCard project={project} index={index} total={projects.length} />)}
      </div>

      <div class="deck-dots" data-work-dots aria-label="Featured work position" aria-hidden="true">
        {projects.map((_project, index) => (
          <span class="deck-dot" data-deck-index={index} aria-current={index === 0 ? "true" : "false"}></span>
        ))}
      </div>
      <p class="deck-status" id="work-deck-status" data-deck-status role="status" aria-live="polite"></p>

      <button class="work-carousel__control work-carousel__control--next" type="button" aria-label="Show next project" data-work-next>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 6 6 6-6 6"></path></svg>
      </button>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const carousel = document.querySelector("[data-work-carousel]");
    const track = carousel?.querySelector("[data-work-track]");
    const cards = track ? Array.from(track.querySelectorAll(".work-card")) : [];
    const dots = carousel
      ? Array.from(carousel.querySelectorAll("[data-work-dots] [data-deck-index]"))
      : [];
    const previousButton = carousel?.querySelector("[data-work-prev]");
    const nextButton = carousel?.querySelector("[data-work-next]");

    if (!carousel || !track || cards.length < 2) return;

    const SWIPE_THRESHOLD = 48;
    const AXIS_RATIO = 1.2;
    const TAP_MOVEMENT_THRESHOLD = 8;
    let activeIndex = 0;
    let gesture = null;
    let suppressClick = false;

    const wrap = (index) => (index + cards.length) % cards.length;
    const cardTitle = (card) =>
      card.querySelector("h3")?.textContent.trim() || "Featured work";

    const render = () => {
      activeIndex = wrap(activeIndex);

      cards.forEach((card, index) => {
        const offset = (index - activeIndex + cards.length) % cards.length;
        const isActive = offset === 0;
        const isPrevious = offset === cards.length - 1;
        const isNext = offset === 1;

        card.classList.toggle("is-active", isActive);
        card.classList.toggle("is-prev", isPrevious);
        card.classList.toggle("is-next", isNext);
        card.classList.toggle("is-hidden", !isActive && !isPrevious && !isNext);
        card.setAttribute(
          "aria-label",
          `${index + 1} of ${cards.length}: ${cardTitle(card)}${isActive ? ", selected" : ""}`,
        );
        card.setAttribute("aria-current", String(isActive));
        card.setAttribute("aria-posinset", String(index + 1));
        card.setAttribute("aria-setsize", String(cards.length));
        card.querySelectorAll("a").forEach((link) => {
          link.tabIndex = isActive ? 0 : -1;
          link.setAttribute("aria-disabled", String(!isActive));
        });
      });

      dots.forEach((dot, index) => {
        dot.setAttribute("aria-current", String(index === activeIndex));
      });

      const status = carousel.querySelector("[data-deck-status]");
      if (status) {
        status.textContent = `Featured work ${activeIndex + 1} of ${cards.length}: ${cardTitle(cards[activeIndex])}`;
      }
    };

    const select = (index, moveFocus = false) => {
      activeIndex = wrap(index);
      render();
      if (moveFocus) track.focus({ preventScroll: true });
    };

    const beginGesture = (startX, startY, pointerId = null) => {
      suppressClick = false;
      gesture = { startX, startY, pointerId };
    };

    const completeGesture = (endX, endY) => {
      if (!gesture) return;

      const { startX, startY } = gesture;
      gesture = null;
      const deltaX = endX - startX;
      const deltaY = endY - startY;
      const horizontalDistance = Math.abs(deltaX);
      const verticalDistance = Math.abs(deltaY);

      if (Math.max(horizontalDistance, verticalDistance) < TAP_MOVEMENT_THRESHOLD) return;

      suppressClick = true;
      if (
        horizontalDistance < SWIPE_THRESHOLD ||
        horizontalDistance <= verticalDistance * AXIS_RATIO
      ) {
        return;
      }

      select(activeIndex + (deltaX < 0 ? 1 : -1));
    };

    const releasePointer = (pointerId) => {
      try {
        if (track.hasPointerCapture?.(pointerId)) track.releasePointerCapture(pointerId);
      } catch {
        // Synthetic browser tests and cancelled native gestures may not own capture.
      }
    };

    cards.forEach((card, index) => {
      card.addEventListener("click", (event) => {
        const target = event.target;
        const link = target instanceof Element ? target.closest("a") : null;
        if (link && index === activeIndex) return;
        if (index !== activeIndex) {
          event.preventDefault();
          select(index, true);
        }
      });
    });

    track.addEventListener("click", (event) => {
      if (suppressClick) {
        event.preventDefault();
        event.stopPropagation();
        suppressClick = false;
        return;
      }

      const elements = document.elementsFromPoint(event.clientX, event.clientY);
      const activeCard = elements.find((element) =>
        element.closest(".work-card")?.classList.contains("is-active"),
      );
      if (activeCard) return;

      const sideCard = elements
        .map((element) => element.closest(".work-card"))
        .find((card) => card && card !== cards[activeIndex]);
      const sideIndex = sideCard ? cards.indexOf(sideCard) : -1;
      if (sideIndex === -1) return;

      event.preventDefault();
      select(sideIndex, true);
    }, true);

    track.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        select(activeIndex - 1);
        track.focus({ preventScroll: true });
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        select(activeIndex + 1);
        track.focus({ preventScroll: true });
      }
    });

    previousButton?.addEventListener("click", () => select(activeIndex - 1, true));
    nextButton?.addEventListener("click", () => select(activeIndex + 1, true));

    track.addEventListener("pointerdown", (event) => {
      if (!event.isPrimary) return;
      beginGesture(event.clientX, event.clientY, event.pointerId);
      try {
        track.setPointerCapture(event.pointerId);
      } catch {
        // Synthetic browser tests may dispatch an uncaptured pointer.
      }
    });

    track.addEventListener("pointerup", (event) => {
      if (!gesture || gesture.pointerId !== event.pointerId) return;
      releasePointer(event.pointerId);
      completeGesture(event.clientX, event.clientY);
    });

    track.addEventListener("pointercancel", () => {
      gesture = null;
      suppressClick = false;
    });

    if (!window.PointerEvent) {
      track.addEventListener("touchstart", (event) => {
        const touch = event.changedTouches[0];
        if (touch) beginGesture(touch.clientX, touch.clientY);
      }, { passive: true });

      track.addEventListener("touchend", (event) => {
        const touch = event.changedTouches[0];
        if (touch) completeGesture(touch.clientX, touch.clientY);
      }, { passive: true });

      track.addEventListener("touchcancel", () => {
        gesture = null;
        suppressClick = false;
      }, { passive: true });
    }

    const preserveSelection = () => {
      activeIndex = wrap(activeIndex);
      render();
    };

    window.addEventListener("resize", preserveSelection);
    window.addEventListener("orientationchange", preserveSelection);

    track.setAttribute(
      "aria-label",
      "Featured work. Select a side card or use Left Arrow and Right Arrow to change the centered item.",
    );
    render();
  })();
</script>
