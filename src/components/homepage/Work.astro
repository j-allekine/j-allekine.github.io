---
import SectionHeader from "../shared/SectionHeader.astro";
import ProjectCard from "../work/ProjectCard.astro";
import { getFeaturedProjects } from "../../data/projects";

const projects = await getFeaturedProjects();
---

<section class="section" id="work">
  <div class="content-shell">
    <SectionHeader label="Featured projects" title="Selected work." href="/work" linkLabel="See all work" />

    <div class="work-carousel" data-work-carousel role="region" aria-roledescription="carousel" aria-label="Featured Work carousel" aria-describedby="work-deck-status">
      <button class="work-carousel__control work-carousel__control--prev" type="button" aria-label="Show previous project" data-work-prev>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 6-6 6 6 6"></path></svg>
      </button>

      <div class="work-grid" data-work-track tabindex="0" role="group" aria-label="Featured Work cards. Use Left Arrow or Right Arrow to change the selected case study.">
        {projects.map((project, index) => <ProjectCard project={project} index={index} total={projects.length} />)}
      </div>

      <div class="deck-dots" data-work-dots aria-label="Featured work position" aria-hidden="true">
        {projects.map((_project, index) => (
          <span class="deck-dot" data-deck-index={index} aria-current={index === 0 ? "true" : "false"}></span>
        ))}
      </div>
      <p class="deck-status" id="work-deck-status" data-deck-status role="status" aria-live="polite"></p>

      <button class="work-carousel__control work-carousel__control--next" type="button" aria-label="Show next project" data-work-next>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 6 6 6-6 6"></path></svg>
      </button>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const initDeck = ({ carouselSelector, trackSelector, cardSelector, prevSelector, nextSelector, dotsSelector, itemName }) => {
      const carousel = document.querySelector(carouselSelector);
      const track = carousel?.querySelector(trackSelector);
      const prev = carousel?.querySelector(prevSelector);
      const next = carousel?.querySelector(nextSelector);
      const cards = track ? Array.from(track.querySelectorAll(cardSelector)) : [];
      const dots = carousel ? Array.from(carousel.querySelectorAll(`${dotsSelector} [data-deck-index]`)) : [];

      if (!carousel || !track || !prev || !next || cards.length < 2) return;

      let activeIndex = 0;
      let pointerStart = null;
      let pointerGesture = false;

      const wrap = (index) => (index + cards.length) % cards.length;
      const cardTitle = (card) => card.querySelector("h3")?.textContent.trim() || itemName;
      const isDeckMode = () => true;

      const setCardLinkState = (card, isActive) => {
        const actionable = !isDeckMode() || isActive;
        card.querySelectorAll("a").forEach((link) => {
          link.tabIndex = actionable ? 0 : -1;
          link.setAttribute("aria-disabled", String(!actionable));
        });
      };

      const render = () => {
        cards.forEach((card, index) => {
          const offset = (index - activeIndex + cards.length) % cards.length;
          const isActive = offset === 0;
          const isPrevious = offset === cards.length - 1;
          const isNext = offset === 1;

          card.classList.toggle("is-active", isActive);
          card.classList.toggle("is-prev", isPrevious);
          card.classList.toggle("is-next", isNext);
          card.classList.toggle("is-hidden", !isActive && !isPrevious && !isNext);
          card.setAttribute("aria-label", `${index + 1} of ${cards.length}: ${cardTitle(card)}${isActive ? ", selected" : ""}`);
          card.setAttribute("aria-current", String(isActive));
          setCardLinkState(card, isActive);
        });

        dots.forEach((dot, index) => dot.setAttribute("aria-current", String(index === activeIndex)));
        const status = carousel.querySelector("[data-deck-status]");
        if (status) status.textContent = `${itemName} ${activeIndex + 1} of ${cards.length}: ${cardTitle(cards[activeIndex])}`;
      };

      const select = (index) => {
        activeIndex = wrap(index);
        render();
      };

      const completeSwipe = (endX, endY) => {
        if (!pointerStart) return;

        const deltaX = endX - pointerStart.x;
        const deltaY = endY - pointerStart.y;
        pointerStart = null;

        if (Math.abs(deltaX) < 44 || Math.abs(deltaX) <= Math.abs(deltaY) * 1.15) return;
        select(activeIndex + (deltaX < 0 ? 1 : -1));
      };

      prev.addEventListener("click", () => select(activeIndex - 1));
      next.addEventListener("click", () => select(activeIndex + 1));
      dots.forEach((dot) => dot.addEventListener("click", () => select(Number(dot.dataset.deckIndex))));

      cards.forEach((card, index) => {
        card.addEventListener("click", (event) => {
          if (!isDeckMode()) return;
          const link = event.target.closest("a");
          if (link && index === activeIndex) return;
          if (index !== activeIndex) {
            event.preventDefault();
            select(index);
          }
        });
      });

      track.addEventListener("click", (event) => {
        if (!isDeckMode()) return;

        const target = event.target instanceof Element ? event.target : null;
        if (target?.closest("a")) return;

        const card = target?.closest(cardSelector)
          || document.elementFromPoint(event.clientX, event.clientY)?.closest(cardSelector);
        const index = card ? cards.indexOf(card) : -1;

        if (index < 0 || index === activeIndex) return;
        event.preventDefault();
        select(index);
      });

      track.addEventListener("keydown", (event) => {
        if (!isDeckMode()) return;
        if (event.key === "ArrowLeft") {
          event.preventDefault();
          select(activeIndex - 1);
          track.focus();
        } else if (event.key === "ArrowRight") {
          event.preventDefault();
          select(activeIndex + 1);
          track.focus();
        }
      });

      track.addEventListener("pointerdown", (event) => {
        if (!isDeckMode() || !event.isPrimary) return;
        pointerGesture = true;
        pointerStart = { x: event.clientX, y: event.clientY };
        track.setPointerCapture?.(event.pointerId);
      });

      track.addEventListener("pointerup", (event) => {
        if (!isDeckMode()) return;
        pointerGesture = false;
        track.releasePointerCapture?.(event.pointerId);
        completeSwipe(event.clientX, event.clientY);
      });

      track.addEventListener("pointercancel", () => {
        pointerGesture = false;
        pointerStart = null;
      });

      if (!window.PointerEvent) {
        track.addEventListener("touchstart", (event) => {
          if (!isDeckMode() || pointerStart) return;
          const touch = event.changedTouches[0];
          pointerStart = { x: touch.clientX, y: touch.clientY };
        }, { passive: true });

        track.addEventListener("touchend", (event) => {
          if (!isDeckMode() || pointerGesture) return;
          const touch = event.changedTouches[0];
          completeSwipe(touch.clientX, touch.clientY);
        }, { passive: true });

        track.addEventListener("touchcancel", () => { pointerStart = null; }, { passive: true });
      }

      window.addEventListener("resize", render);
      render();
    };

    const initializeHomepageDecks = () => {
      initDeck({ carouselSelector: "[data-work-carousel]", trackSelector: "[data-work-track]", cardSelector: ".work-card", prevSelector: "[data-work-prev]", nextSelector: "[data-work-next]", dotsSelector: "[data-work-dots]", itemName: "Featured project" });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initializeHomepageDecks, { once: true });
    } else {
      initializeHomepageDecks();
    }
  })();
</script>
