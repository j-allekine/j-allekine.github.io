<script is:inline>
  (() => {
    const cards = Array.from(document.querySelectorAll(".work-card"));
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!cards.length || reduceMotion || !("IntersectionObserver" in window)) {
      return;
    }

    cards.forEach((card, index) => {
      card.classList.add("is-pending");
      card.style.setProperty("--reveal-delay", `${index * 80}ms`);
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.classList.remove("is-pending");
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      {
        threshold: 0.18,
        rootMargin: "0px 0px -6% 0px",
      }
    );

    cards.forEach((card) => observer.observe(card));
  })();
</script>

<script is:inline>
  (() => {
    const carousel = document.querySelector("[data-work-carousel]");
    const track = carousel?.querySelector("[data-work-track]");
    const prev = carousel?.querySelector("[data-work-prev]");
    const next = carousel?.querySelector("[data-work-next]");
    const cards = track ? Array.from(track.querySelectorAll(".work-card")) : [];

    if (!carousel || !track || !prev || !next || cards.length < 2) {
      return;
    }

    const getCurrentIndex = () => {
      const current = track.scrollLeft;
      let closestIndex = 0;
      let closestDistance = Number.POSITIVE_INFINITY;

      cards.forEach((card, index) => {
        const distance = Math.abs(card.offsetLeft - current);
        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      return closestIndex;
    };

    const goTo = (index) => {
      const target = cards[(index + cards.length) % cards.length];
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      track.scrollTo({
        left: target.offsetLeft,
        behavior: reduceMotion ? "auto" : "smooth",
      });
    };

    prev.addEventListener("click", () => goTo(getCurrentIndex() - 1));
    next.addEventListener("click", () => goTo(getCurrentIndex() + 1));

    track.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        goTo(getCurrentIndex() - 1);
      }

      if (event.key === "ArrowRight") {
        event.preventDefault();
        goTo(getCurrentIndex() + 1);
      }
    });

    track.setAttribute(
      "aria-label",
      "Featured projects. Swipe horizontally or use the previous and next project buttons."
    );
  })();
</script>
