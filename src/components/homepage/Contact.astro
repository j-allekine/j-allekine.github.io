---
import Button from "../shared/Button.astro";
---

<section class="contact-cta" id="contact">
  <div class="reading-shell">
    <div class="cta-card">
      <div>
        <p class="section-label">Start a conversation</p>
        <h2>Let’s build something that works.</h2>
        <p>Bring the process that feels too manual, too scattered, or too fragile. We can turn it into a clearer system.</p>
      </div>

      <Button href="/contact">Contact Me <span class="arrow" aria-hidden="true">→</span></Button>
    </div>
  </div>
</section>
