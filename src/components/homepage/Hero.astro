---
import Button from "../shared/Button.astro";
---

<section class="hero content-shell" id="hero" aria-labelledby="hero-title">
  <div class="hero-intro">
    <h1 id="hero-title">
      <span class="hero-name-line">JIHM ALLEKINE</span>
      <span class="hero-name-line">ALMEDILLA</span>
    </h1>
    <p class="hero-statement">I am an automation specialist.</p>
  </div>

  <div class="hero-portrait-wrap">
    <div class="hero-portrait" aria-hidden="true">
      <span class="hero-portrait-corner hero-portrait-corner--top" aria-hidden="true"></span>
      <span class="hero-portrait-corner hero-portrait-corner--bottom" aria-hidden="true"></span>
    </div>
  </div>

  <div class="hero-details">
    <p class="hero-copy hero-copy--lead">
      I build spreadsheet systems, workflow automations, data tools, and practical software that turn manual processes into clearer, more reliable operations. I enjoy mapping workflows, understanding the details, and building useful tools that people can rely on.
    </p>
    <p class="hero-copy">
      My Christian faith shapes how I approach my work. I see building as an act of stewardship: serving people well, pursuing excellence, and creating work that honors God.
    </p>

    <div class="hero-actions">
      <Button href="#work">
        View selected work <span class="arrow" aria-hidden="true">&#8595;</span>
      </Button>
      <Button href="/contact" variant="ghost">
        Contact me <span class="arrow" aria-hidden="true">&#8599;</span>
      </Button>
    </div>
  </div>
</section>
