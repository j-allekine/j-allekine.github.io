---
import Button from "../shared/Button.astro";
import SocialLinks from "../shared/SocialLinks.astro";
---

<section class="hero shell" aria-labelledby="hero-title">
  <div class="hero-intro">
    <p class="hero-label">Systems &amp; Automation Developer</p>
    <h1 id="hero-title">
      <span class="hero-name-line">Jihm Allekine</span>
      <span class="hero-name-line">Almedilla</span>
    </h1>
  </div>

  <div class="hero-portrait-wrap">
    <div class="hero-portrait" role="img" aria-label="Temporary portrait area for Jihm Allekine Almedilla">
      <span class="hero-portrait-corner hero-portrait-corner--top" aria-hidden="true"></span>
      <span class="hero-portrait-corner hero-portrait-corner--bottom" aria-hidden="true"></span>
    </div>
  </div>

  <div class="hero-details">
    <p class="hero-copy hero-copy--lead">
      I build spreadsheet systems, workflow automations, data tools, and practical software that turn manual processes into clearer, more reliable operations. I enjoy mapping workflows, understanding the details, and building useful tools that people can rely on.
    </p>
    <p class="hero-copy">
      My Christian faith shapes how I approach my work. I see building as an act of stewardship: serving people well, pursuing excellence, and creating work that honors God.
    </p>

    <div class="hero-actions">
      <Button href="#contact" bookingPlaceholder>
        <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3.5" y="5.5" width="17" height="15" rx="2"></rect>
          <path d="M7.5 3.5v4M16.5 3.5v4M3.5 9.5h17"></path>
        </svg>
        Book a 30-minute call <span class="arrow" aria-hidden="true">↗</span>
      </Button>
      <Button href="#work" variant="ghost">
        View Work <span class="arrow" aria-hidden="true">→</span>
      </Button>
    </div>

    <div class="hero-socials"><SocialLinks /></div>
  </div>
</section>
