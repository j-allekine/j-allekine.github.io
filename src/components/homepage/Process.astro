<section class="section" id="process">
  <div class="content-shell process-shell">
    <div class="process-heading">
      <p class="section-label">How I work</p>
      <h2>My process.</h2>
    </div>

    <div class="process-interactive" data-process>
      <div class="process-nav" role="tablist" aria-label="Four-step working process">
        <button class="process-tab" type="button" role="tab" aria-selected="true" aria-controls="process-panel" id="process-tab-discovery" data-process-step="discovery" data-title="Discovery" data-description="We start with a focused call to understand your current process, pain points, tools involved, and the outcome you want to achieve.">
          <span class="process-tab__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"></path></svg></span>
          <span class="process-tab__label">Discovery</span><span class="process-tab__dot" aria-hidden="true"></span>
        </button>
        <button class="process-tab" type="button" role="tab" aria-selected="false" aria-controls="process-panel" id="process-tab-plan" tabindex="-1" data-process-step="plan" data-title="Plan" data-description="I turn your process into a clear roadmap — what happens, who's responsible, what to do when things don't go as expected. You'll see the whole system before I build a single line, so there are no surprises later.">
          <span class="process-tab__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M15 6a9 9 0 0 0-9 9V3"></path><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle></svg></span>
          <span class="process-tab__label">Plan</span><span class="process-tab__dot" aria-hidden="true"></span>
        </button>
        <button class="process-tab" type="button" role="tab" aria-selected="false" aria-controls="process-panel" id="process-tab-build" tabindex="-1" data-process-step="build" data-title="Build" data-description="Built around how you actually work, not a generic template. Tested on real scenarios, refined with your feedback, so what launches is something your team already trusts.">
          <span class="process-tab__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect width="7" height="7" x="3" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="14" rx="1"></rect><rect width="7" height="7" x="3" y="14" rx="1"></rect></svg></span>
          <span class="process-tab__label">Build</span><span class="process-tab__dot" aria-hidden="true"></span>
        </button>
        <button class="process-tab" type="button" role="tab" aria-selected="false" aria-controls="process-panel" id="process-tab-launch" tabindex="-1" data-process-step="launch" data-title="Launch" data-description="You're not left to figure it out alone. I hand it over with clear documentation and hands-on support, so the transition feels steady, not stressful.">
          <span class="process-tab__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09"></path><path d="M9 12a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.4 22.4 0 0 1-4 2z"></path><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 .05 5 .05"></path></svg></span>
          <span class="process-tab__label">Launch</span><span class="process-tab__dot" aria-hidden="true"></span>
        </button>
      </div>

      <div class="process-panel" id="process-panel" role="tabpanel" aria-labelledby="process-tab-discovery" tabindex="0" aria-live="polite">
        <p class="process-panel__eyebrow" data-process-title>Discovery</p>
        <p class="process-panel__description" data-process-description>We start with a focused call to understand your current process, pain points, tools involved, and the outcome you want to achieve.</p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const process = document.querySelector("[data-process]");
    if (!process) return;

    const tabs = Array.from(process.querySelectorAll("[data-process-step]"));
    const panel = process.querySelector("#process-panel");
    const title = process.querySelector("[data-process-title]");
    const description = process.querySelector("[data-process-description]");
    if (!tabs.length || !panel || !title || !description) return;

    const selectStep = (tab, moveFocus = false) => {
      tabs.forEach((item) => {
        const selected = item === tab;
        item.setAttribute("aria-selected", String(selected));
        item.tabIndex = selected ? 0 : -1;
      });
      title.textContent = tab.dataset.title || "";
      description.textContent = tab.dataset.description || "";
      panel.setAttribute("aria-labelledby", tab.id);
      if (moveFocus) tab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectStep(tab));
      tab.addEventListener("focus", () => selectStep(tab));
      tab.addEventListener("keydown", (event) => {
        let nextIndex = null;
        if (event.key === "ArrowRight" || event.key === "ArrowDown") nextIndex = (index + 1) % tabs.length;
        if (event.key === "ArrowLeft" || event.key === "ArrowUp") nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === "Home") nextIndex = 0;
        if (event.key === "End") nextIndex = tabs.length - 1;
        if (nextIndex === null) return;
        event.preventDefault();
        selectStep(tabs[nextIndex], true);
      });
    });
  })();
</script>
