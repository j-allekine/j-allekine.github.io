---
import type { SiteConfig } from '../data/portfolio';

interface Props {
  capabilities: SiteConfig['capabilities'];
}

const { capabilities } = Astro.props;
---

<ul class="capability-ledger">
  {
    capabilities.map((capability, index) => (
      <li>
        <p class="capability-ledger__number">
          {(index + 1).toString().padStart(2, '0')}
        </p>
        <dl>
          <div>
            <dt>Operational problem</dt>
            <dd>{capability.problem}</dd>
          </div>
          <div>
            <dt>Practical improvement</dt>
            <dd>{capability.improvement}</dd>
          </div>
        </dl>
      </li>
    ))
  }
</ul>

<style>
  .capability-ledger {
    padding: 0;
    margin: 0;
    border-top: 1px solid #111;
    list-style: none;
  }

  .capability-ledger li {
    display: grid;
    grid-template-columns: minmax(3rem, 0.5fr) minmax(0, 5.5fr);
    gap: clamp(1rem, 3vw, 3rem);
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid #bbb;
  }

  .capability-ledger__number {
    margin: 0;
    font-family: "Courier New", Courier, monospace;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 4rem);
    margin: 0;
  }

  dd {
    max-width: 36rem;
    margin: 0.5rem 0 0;
  }

  @media (max-width: 40rem) {
    .capability-ledger li,
    dl {
      grid-template-columns: 1fr;
    }

    .capability-ledger li {
      gap: 0.75rem;
    }
  }
</style>
