---
import { siteConfig, type SiteConfig } from '../data/portfolio';
import CrossMark from './CrossMark.astro';

const usableDestination = (value?: string) => {
  const destination = value?.trim();
  return destination && destination !== '#' ? destination : undefined;
};

const contact: SiteConfig['contact'] = siteConfig.contact;
const email = usableDestination(contact.email);
const navigationItems = [
  { label: 'Work', href: '/#featured-work' },
  {
    label: 'Capabilities',
    href:
      siteConfig.capabilities.length > 0
        ? '/#capabilities-heading'
        : undefined,
  },
  {
    label: 'Resume',
    href: usableDestination(contact.resumeUrl),
  },
  {
    label: 'GitHub',
    href: usableDestination(contact.githubUrl),
  },
  {
    label: 'Contact',
    href: email ? `mailto:${email}` : undefined,
  },
];
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="site-identity" href="/">
      <CrossMark />
      <span>{siteConfig.ownerName}</span>
    </a>

    <button
      class="menu-button"
      type="button"
      data-menu-button
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="site-navigation"
    >
      Menu
    </button>

    <nav
      class="primary-navigation"
      id="site-navigation"
      aria-label="Primary"
    >
      <ul>
        {
          navigationItems.map((item) => (
            <li>
              {item.href ? (
                <a href={item.href}>{item.label}</a>
              ) : (
                <span class="navigation-item--unavailable">
                  {item.label}
                  <span class="navigation-item__state">Unavailable</span>
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const menuButton =
    document.querySelector<HTMLButtonElement>('[data-menu-button]');

  function setMenuOpen(open: boolean) {
    if (!menuButton) return;

    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute(
      'aria-label',
      open ? 'Close navigation' : 'Open navigation',
    );
  }

  menuButton?.addEventListener('click', () => {
    setMenuOpen(menuButton.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (event) => {
    if (
      event.key === 'Escape' &&
      menuButton?.getAttribute('aria-expanded') === 'true'
    ) {
      setMenuOpen(false);
      menuButton.focus();
    }
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid #111;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.5rem;
    gap: 2rem;
  }

  .site-identity {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    gap: 0.75rem;
    font-weight: 700;
    text-decoration: none;
  }

  .primary-navigation ul {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu-button {
    display: none;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid currentColor;
    border-radius: 0;
    color: inherit;
    background: #fff;
    font: inherit;
    font-size: 0.85rem;
  }

  .menu-button:hover {
    background: #f4f4f1;
  }

  .menu-button:active {
    background: #e8e8e4;
  }

  .primary-navigation a,
  .navigation-item--unavailable {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.85rem;
  }

  .navigation-item--unavailable {
    gap: 0.35rem;
    color: #555;
  }

  .navigation-item__state {
    font-size: 0.7rem;
  }

  @media (max-width: 47.99rem) {
    .site-header__inner {
      flex-wrap: wrap;
    }

    .menu-button {
      display: inline-flex;
    }

    .primary-navigation {
      display: none;
      flex-basis: 100%;
      padding-block: 0.5rem 1rem;
      border-top: 1px solid #bbb;
    }

    .menu-button[aria-expanded='true'] + .primary-navigation {
      display: block;
    }

    .primary-navigation ul {
      display: grid;
      gap: 0;
    }

    .primary-navigation a,
    .navigation-item--unavailable {
      width: 100%;
    }
  }
</style>
